{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tbar profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "buttons"],
  "properties": {
    "name": {"type": "string", "minLength": 1, "maxLength": 40, "pattern": "^\\S(?:[\\s\\S]*\\S)?$"},
    "theme": {"anyOf": [{"enum": ["auto", "tinted", "accent", "red", "orange", "yellow", "green", "cyan", "blue", "magenta"]},
                        {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}]},
    "escLabel": {"type": "string", "minLength": 1, "maxLength": 16, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*\\S[^\\u0000-\\u001f\\u007f-\\u009f]*$"},
    "escIcon": {"type": "string", "minLength": 1, "maxLength": 4, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*\\S[^\\u0000-\\u001f\\u007f-\\u009f]*$"},
    "font": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*\\S[^\\u0000-\\u001f\\u007f-\\u009f]*$"},
    "idleDim": {"type": "integer", "minimum": 0, "maximum": 3600},
    "screensaver": {"type": "integer", "minimum": 0, "maximum": 3600},
    "screensaverStyle": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,23}$"},
    "screensaverText": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*\\S[^\\u0000-\\u001f\\u007f-\\u009f]*$"},
    "screensaverImage": {"type": "string", "maxLength": 512, "pattern": "^/[^\\u0000-\\u001f\\u007f-\\u009f]*\\.[pP][nN][gG]$"},
    "backgroundImage": {"type": "string", "maxLength": 512, "pattern": "^/[^\\u0000-\\u001f\\u007f-\\u009f]*\\.[pP][nN][gG]$"},
    "apps": {"type": "array", "maxItems": 8, "items": {"type": "string", "pattern": "^[A-Za-z0-9._+-]{1,64}$"}},
    "buttons": {
      "type": "array", "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label"],
        "properties": {
          "label": {"type": "string", "minLength": 1, "maxLength": 16, "pattern": "^[^\\u0000\\r\\n]*\\S[^\\u0000\\r\\n]*$"},
          "kind": {"enum": ["button", "internet", "temperature", "process", "widget", "spacer", "control", "scene", "scene-next"]},
          "command": {"type": "string", "maxLength": 1024, "pattern": "^[^\\u0000]*$"},
          "section": {"enum": ["left", "center", "right"]},
          "width": {"type": "integer", "minimum": 10, "maximum": 500},
          "style": {"enum": ["dots", "bars"]},
          "interval": {"type": "integer", "minimum": 1, "maximum": 60},
          "temperature": {"type": "boolean"},
          "icon": {"type": "string", "minLength": 1, "maxLength": 4, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*\\S[^\\u0000-\\u001f\\u007f-\\u009f]*$"}
        },
        "allOf": [
          {"if": {"properties": {"kind": {"const": "button"}}},
           "then": {"required": ["command"], "properties": {"command": {"pattern": "\\S"}}}},
          {"if": {"required": ["kind"], "properties": {"kind": {"const": "widget"}}},
           "then": {"required": ["command"], "properties": {"command": {"enum": ["cpu", "memory", "network", "disk", "battery"]}}}},
          {"if": {"required": ["kind"], "properties": {"kind": {"const": "control"}}},
           "then": {"required": ["command"], "properties": {"command": {"enum": ["volume", "brightness", "keyboard", "media", "mic"]}}}},
          {"if": {"required": ["kind"], "properties": {"kind": {"const": "scene"}}},
           "then": {"required": ["command"], "properties": {"command": {"maxLength": 40, "pattern": "^\\S(?:[\\s\\S]*\\S)?$"}}}},
          {"if": {"required": ["kind"], "properties": {"kind": {"const": "scene-next"}}},
           "then": {"properties": {"command": {"const": ""}}}},
          {"if": {"required": ["kind"], "properties": {"kind": {"const": "process"}}},
           "then": {"required": ["command"], "properties": {"command": {"pattern": "^[A-Za-z0-9._+-]{1,15}$"}}}},
          {"if": {"anyOf": [{"required": ["style"]}, {"required": ["interval"]}]},
           "then": {"required": ["kind"], "properties": {"kind": {"const": "widget"}}}},
          {"if": {"required": ["icon"]},
           "then": {"properties": {"kind": {"enum": ["button", "scene", "scene-next"]}}}},
          {"if": {"required": ["temperature"]},
           "then": {"required": ["kind", "command"], "properties": {"kind": {"const": "widget"}, "command": {"const": "cpu"}}}}
        ]
      }
    }
  }
}
