pkgname=tbar
pkgver=0.1.0
pkgrel=11
pkgdesc="Touch Bar scene editor for Omarchy (experimental)"
arch=('x86_64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative')
makedepends=('base-devel')
optdepends=('networkmanager: internet status' 'procps-ng: application status')

# The source tree already has a src/ directory; makepkg must not clean it.
if [[ $BUILDDIR -ef $startdir ]]; then
  BUILDDIR="$startdir/build/package"
fi

build() {
  cd "$srcdir"
  qmake6 "$startdir/tbar.pro"
  make
}

package() {
  install -Dm755 "$srcdir/tbar" "$pkgdir/usr/bin/tbar"
  install -Dm644 "$startdir/pkgbuild/tbar.desktop" "$pkgdir/usr/share/applications/tbar.desktop"
  install -Dm644 "$startdir/pkgbuild/tbar.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/tbar.svg"
  install -Dm755 "$startdir/pkgbuild/tbar-theme-sync" "$pkgdir/usr/share/tbar/tbar-theme-sync"
  install -Dm644 "$startdir/pkgbuild/tbar-watch.service" "$pkgdir/usr/lib/systemd/user/tbar-watch.service"
  install -Dm644 "$startdir/../LICENSE" "$pkgdir/usr/share/licenses/tbar/LICENSE"
}
